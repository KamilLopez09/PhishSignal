# FastAPI origin (no trailing slash). When unset, the UI uses offline mockAnalyze().
# Same-origin proxy via next.config.mjs rewrite:
NEXT_PUBLIC_API_BASE_URL=/backend

# Direct alternative (no rewrite):
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Next → FastAPI rewrite target (default http://127.0.0.1:8000)
# PHISHSIGNAL_API_PROXY=http://127.0.0.1:8000
