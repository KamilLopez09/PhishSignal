# FastAPI origin (no trailing slash).
# Unset → https://phishsignal.onrender.com
# mock → offline mockAnalyze()
# /backend → same-origin proxy via next.config.mjs
# NEXT_PUBLIC_API_BASE_URL=https://phishsignal.onrender.com

# Local proxy (avoids CORS during `npm run dev`):
# NEXT_PUBLIC_API_BASE_URL=/backend

# Direct local FastAPI:
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Offline fixtures:
# NEXT_PUBLIC_API_BASE_URL=mock

# Next → FastAPI rewrite target (default http://127.0.0.1:8000)
# PHISHSIGNAL_API_PROXY=http://127.0.0.1:8000
