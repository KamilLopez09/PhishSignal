# API (local uvicorn)
# Comma-separated browser origins. Empty = allow all (local only).
# CORS_ORIGINS=http://localhost:3000

# Analyze rate limit (per client IP)
# RATE_LIMIT_CAPACITY=20
# RATE_LIMIT_REFILL_PER_SEC=0.5

# Boot: load model.pkl. Set to 1 only when intentionally retraining.
# TRAIN_MODEL=0
# MODEL_PATH=model.pkl
# DATASET_PATH=apidataset.csv
